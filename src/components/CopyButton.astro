---
// Copies `text` to the clipboard. Without JavaScript the button stays hidden and
// the command is still selectable.
interface Props { text: string; label?: string }
const { text, label = 'Copy' } = Astro.props;
---
<button type="button" class="copy" data-copy={text} hidden>
  <span class="copy-label">{label}</span>
  <span class="visually-hidden" aria-live="polite"></span>
</button>

<style>
  .copy {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    color: var(--fg-strong);
    background: transparent;
    border: 2px solid var(--fg-strong);
    border-radius: 999px;
    padding: 0.8rem 1.4rem;
    cursor: pointer;
    min-height: 48px;
  }
  .copy:hover { background: var(--fg-strong); color: var(--bg); }
  .copy[data-done] { background: var(--fg-strong); color: var(--bg); }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button.copy[data-copy]')) {
    if (!navigator.clipboard) continue;
    btn.hidden = false;
    const label = btn.querySelector('.copy-label')!;
    const live = btn.querySelector('[aria-live]')!;
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        label.textContent = 'Copied';
        live.textContent = 'Copied to clipboard';
        btn.dataset.done = '';
      } catch {
        label.textContent = 'Select to copy';
      }
      setTimeout(() => { label.textContent = original; live.textContent = ''; delete btn.dataset.done; }, 1800);
    });
  }
</script>
