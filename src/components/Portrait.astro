---
// The portrait slot. With PORTRAIT set in src/lib/site.ts it shows the photo;
// until then it shows a typographic place card, so the page is finished either way.
import { PORTRAIT, SITE } from '../lib/site';
const places = ['San Salvador', 'Lisboa', 'Abu Dhabi'];
---
{PORTRAIT ? (
  <figure class="portrait">
    <img src={PORTRAIT.src} srcset={`${PORTRAIT.small} 400w, ${PORTRAIT.src} ${PORTRAIT.width}w`} sizes="(min-width: 900px) 320px, 192px" alt={`Portrait of ${SITE.name}`} width={PORTRAIT.width} height={PORTRAIT.height} loading="lazy" decoding="async" />
    <figcaption>{places.join(', ')}</figcaption>
  </figure>
) : (
  <div class="places">
    <p class="visually-hidden">Based in Abu Dhabi, after San Salvador and Lisbon. Works in English, Spanish and Portuguese.</p>
    <ol aria-hidden="true">
      {places.map((p) => <li>{p}</li>)}
    </ol>
    <p class="langs" aria-hidden="true">English, Español, Português</p>
  </div>
)}

<style>
  .portrait { margin: 0; max-width: 12rem; }
  @media (min-width: 900px) { .portrait { max-width: 20rem; } }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-panel); background: var(--mist); }
  .portrait figcaption { margin-top: var(--space-3); font-size: var(--step--1); color: var(--muted); }

  .places { background: var(--mist); border-radius: var(--radius-panel); padding: var(--space-6); display: grid; gap: var(--space-6); align-content: space-between; min-height: 18rem; }
  .places ol { list-style: none; margin: 0; padding: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.6rem); line-height: 1.05; letter-spacing: -0.035em; color: var(--ink); }
  .places li { color: var(--border-strong); }
  .places li:last-child { color: var(--cobalt); }
  .places .langs { margin: 0; font-size: var(--step--1); font-weight: 600; color: var(--ink); }
  @media (min-width: 900px) { .places { min-height: 24rem; } }
</style>
