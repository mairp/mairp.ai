---
/**
 * RoomIsland.astro — thin Astro wrapper mounting the lazy 3D island.
 *
 * `client:only="react"` keeps React/three.js out of the initial payload and
 * the static HTML path: the flat page renders server-side, and the island
 * hydrates only in browsers where the client renderer activates (FR-002).
 * The `payload` prop carries the per-page room payload slice.
 *
 * Phase 1 skeleton (attempt 4); no mount in pages yet — nothing imports this
 * wrapper, so pages stay byte-identical to the pre-refactor baseline.
 */
interface Props {
  payload?: unknown;
}
const { payload } = Astro.props;
import RoomIsland from '../islands/room3d/Room3D';
---

<RoomIsland client:only="react" payload={payload} />
