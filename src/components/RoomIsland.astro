---
/**
 * RoomIsland.astro — thin Astro wrapper mounting the lazy 3D island.
 *
 * Phase 2 (T008): mounted at the end of every content page (index, about,
 * services) with its per-page Room Payload (T006/T007). `/404` mounts nothing
 * (contracts/url-room-map.md rule 5).
 *
 * Hydration strategy: NOT `client:only` — Astro's client directives emit extra
 * inline bootstrap scripts, which would break the strict CSP gate of exactly
 * one hash-pinned inline script (FR-014, scripts/csp-hash.mjs). Instead:
 * - the payload is embedded as a `<script type="application/json">` data block
 *   (data, not executed; CSP-inert),
 * - a bundled external module (the <script> below, processed by Astro) mounts
 *   the React island manually after the page is interactive (FR-002).
 * React/three.js stay out of the initial payload: nothing imports the island
 * from any first-paint graph.
 */
import type { RoomPayload } from '../lib/room-payload';

interface Props {
  payload?: RoomPayload;
}
const { payload } = Astro.props;
// JSON data block: escape "</" so the payload can never close its own tag.
const payloadJson = payload ? JSON.stringify(payload).replace(/<\//g, '<\\/') : '';
---

{payload && payloadJson && (
  <>
    <script type="application/json" id="room-payload" set:html={payloadJson} />
    <div id="room-island-root" aria-hidden="true"></div>
    <script>
      // Deferred dynamic import: the island bundle (React + three.js) is
      // requested only once the page is interactive (FR-002/SC-004) — the
      // static module graph of the page itself carries no 3D code.
      const start = () =>
        import('../islands/room3d/mount').then((m) => m.mountRoomIsland());
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => void start(), { timeout: 2000 });
      } else {
        setTimeout(() => void start(), 200);
      }
    </script>
  </>
)}
