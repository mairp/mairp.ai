---
/**
 * RoomIsland.astro — thin Astro wrapper mounting the lazy 3D island.
 *
 * Phase 3 (T066): mounted at the end of every content page (index, about,
 * services). `/404` mounts nothing (contracts/url-room-map.md rule 5).
 *
 * Hydration strategy (unchanged from Phase 2, CSP-safe): Astro's client
 * directives emit extra inline bootstrap scripts, which would break the strict
 * CSP gate of exactly one hash-pinned inline script (FR-014,
 * scripts/csp-hash.mjs), so a bundled external module mounts the React island
 * manually after the page is interactive (FR-002).
 *
 * FR-016: the page's Room Payload is NOT embedded here — the island fetches
 * its self-hosted per-route document (`/rooms/<key>.json`, prerendered by
 * src/pages/rooms/[route].json.ts) at boot. No payload data appears in
 * first-paint HTML (SC-004 baseline).
 */
interface Props {
  /** Kept for call-site compatibility; no longer serialized into HTML. */
  payload?: unknown;
}
const { payload } = Astro.props;
---

{payload && (
  <div id="room-island-root"></div>
)}
{payload && (
  <script>
    // Deferred dynamic import: the island bundle (React + three.js) is
    // requested only once the page is interactive (FR-002/SC-004) — the
    // static module graph of the page itself carries no 3D code.
    // Dev only (stripped from production builds): the manual mount bypasses
    // Astro's React renderer, so satisfy @vitejs/plugin-react's refresh preamble.
    if (import.meta.env.DEV) {
      const w = window as any;
      w.$RefreshReg$ ??= () => {};
      w.$RefreshSig$ ??= () => (t: unknown) => t;
      w.__vite_plugin_react_preamble_installed__ = true;
    }
    const start = () =>
      import('../islands/room3d/mount').then((m) => m.mountRoomIsland());
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 2000 });
    } else {
      setTimeout(() => void start(), 200);
    }
  </script>
)}
