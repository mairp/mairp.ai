---
import { NAV, SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="brand">Marlon Paz</p>
        <p>Network and AI infrastructure architect. Independent consulting from {SITE.location}, in English, Español and Português.</p>
      </div>
      <nav aria-label="Footer">
        <ul role="list">
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={SITE.cv}>Consultant profile (PDF)</a></li>
        </ul>
        <ul role="list">
          <li><a href={SITE.github}>GitHub</a></li>
          <li><a href={SITE.linkedin}>LinkedIn</a></li>
          <li><a href={SITE.credly}>Credly</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </nav>
      <div class="legal muted">
        <p>Every claim on this site links to public evidence: a repository, a paper or a recording. No testimonials and no client logos. Confidential client work appears only as anonymised categories.</p>
        <p>No cookies and no trackers. Page counts are aggregate, by Cloudflare Web Analytics.</p>
        <p>© {year} {SITE.copyright}. This site is <a href="https://github.com/mairp/mairp.ai">open source</a> under MIT.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: var(--space-8); padding: var(--space-7) 0 var(--space-9); font-size: var(--step--1); }
  .cols { display: grid; gap: var(--space-6); }
  @media (min-width: 860px) { .cols { grid-template-columns: 1.2fr 1.3fr 1.5fr; } }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); letter-spacing: -0.02em; color: var(--fg-strong); margin-bottom: var(--space-2); }
  nav { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); align-content: start; }
  ul { list-style: none; padding: 0; margin: 0; }
  ul a { display: inline-flex; align-items: center; min-height: 36px; color: var(--fg-strong); text-decoration: none; overflow-wrap: anywhere; }
  ul a:hover { text-decoration: underline; }
  p { margin-bottom: var(--space-3); }
</style>
