---
// A proof card: the practice's flagship evidence with a dated number badge and
// a verification meter that fills on hover/focus (pure CSS; see global.css).
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'proof'>; headingLevel?: 2 | 3 }
const { entry, headingLevel = 3 } = Astro.props;
const p = entry.data;
const H = headingLevel === 2 ? 'h2' : 'h3';
---
<a class="card card-top proof reveal" href={p.url ?? '/proof/'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener noreferrer' : undefined}>
  <H class="mono pname">{p.name}</H>
  <p>{p.note}</p>
  <span class="badge"><span aria-hidden="true">✓</span> {p.badge} <span class="src">· {p.source}</span></span>
  <span class="meter" aria-hidden="true"></span>
</a>

<style>
  .proof { display: flex; flex-direction: column; text-decoration: none; gap: var(--space-2); }
  .pname { font-family: var(--font-mono); font-size: var(--step-0); letter-spacing: 0; }
  .proof p { margin: 0; flex: 1; }
  .badge { margin-top: var(--space-2); }
</style>
