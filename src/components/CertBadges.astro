---
// The certification badge wall: self-hosted images, each linking to its public
// verification page. The tile background is white so the vendors' badge art
// reads the same in light and dark themes.
import { BADGES, SITE } from '../lib/site';
---
<div class="cert-badges">
  <ul class="cert-grid">
    {BADGES.map((b) => (
      <li>
        <a class="cert-badge" href={b.url} target="_blank" rel="noopener noreferrer" title={`Verify: ${b.name}`}>
          <span class="cert-img"><img src={`/assets/badges/${b.img}.webp`} alt={`${b.name}, ${b.issuer}`} width="96" height="96" loading="lazy" decoding="async" /></span>
          <span class="cert-name">{b.name}</span>
          <span class="cert-meta mono">{b.issuer} · {b.year}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="muted">Every badge links to its public verification page. Full list on <a href={SITE.credly}>Credly</a>.</p>
</div>

<style>
  .cert-grid { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); }
  .cert-badge { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-2); height: 100%;
    padding: var(--space-4) var(--space-3); background: var(--surface); border: 1px solid var(--line, var(--surface-2)); border-radius: var(--radius);
    text-decoration: none; color: var(--fg); transition: transform .2s ease, border-color .2s ease; }
  .cert-badge:hover, .cert-badge:focus-visible { border-color: var(--accent); transform: translateY(-2px); }
  .cert-img { display: grid; place-items: center; width: 6rem; height: 6rem; background: #fff; border-radius: var(--radius); padding: 4px; }
  .cert-img img { width: 100%; height: 100%; object-fit: contain; }
  .cert-name { font-size: var(--step--1); font-weight: 600; line-height: 1.3; color: var(--fg-strong); }
  .cert-meta { font-size: 0.7rem; color: var(--muted); margin-top: auto; }
  @media (prefers-reduced-motion: reduce) { .cert-badge { transition: none; } .cert-badge:hover, .cert-badge:focus-visible { transform: none; } }
</style>
