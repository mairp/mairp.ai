---
// The certification wall: self-hosted images, each linking to its public
// verification page.
import { BADGES, SITE } from '../lib/site';
---
<div class="cert-badges">
  <ul class="cert-grid">
    {BADGES.map((b) => (
      <li>
        <a class="cert-badge" href={b.url} target="_blank" rel="noopener noreferrer" title={`Verify: ${b.name}`}>
          <img src={`/assets/badges/${b.img}.webp`} alt="" width="88" height="88" loading="lazy" decoding="async" />
          <span class="cert-name">{b.name}</span>
          <span class="cert-meta">{b.issuer}, {b.year}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="muted">Each badge opens its public verification page. The full list is on <a href={SITE.credly}>Credly</a>.</p>
</div>

<style>
  .cert-grid { list-style: none; margin: 0 0 var(--space-5); padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .cert-badge {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); height: 100%;
    padding: var(--space-4); background: var(--surface); border-radius: var(--radius);
    text-decoration: none; color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--border);
    transition: box-shadow 0.18s;
  }
  .cert-badge:hover, .cert-badge:focus-visible { box-shadow: inset 0 0 0 2px var(--cobalt); }
  .cert-badge img { width: 5.5rem; height: 5.5rem; object-fit: contain; margin-bottom: var(--space-2); }
  .cert-name { font-size: var(--step--1); font-weight: 650; line-height: 1.3; color: var(--fg-strong); }
  .cert-meta { font-size: 0.8125rem; color: var(--muted); margin-top: auto; }
  @media (prefers-reduced-motion: reduce) { .cert-badge { transition: none; } }
</style>
