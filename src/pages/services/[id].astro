---
// One page per service, from its Markdown file. The front matter is the offer;
// the body is the depth.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const s = entry.data;
const all = await getCollection('services');
const related = all.filter((r) => s.related.includes(r.id));
const [name, tag] = s.name.split(' — ');
---
<Base title={s.name.replace(' — ', ': ')} description={s.oneLine}>
  <div class="wrap page">
    <div class="page-head">
      <p class="crumb"><a href="/#services">Services</a></p>
      <h1>{name}</h1>
      {tag && <p class="tag">{tag}</p>}
      <p class="lede">{s.oneLine}</p>
      <p class="ctas">
        <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Scoping: ' + s.name)}`}>Email Marlon about this</a>
        <button class="btn" type="button" data-twin-open>Ask my digital twin</button>
      </p>
    </div>

    <section class="block" aria-labelledby="b-outcome">
      <h2 id="b-outcome">Outcome</h2>
      <div class="prose">
        <p>{s.summary}</p>
        <dl class="facts">
          <div><dt>Duration</dt><dd>{s.duration}</dd></div>
          {s.vendors.length > 0 && <div><dt>Works with</dt><dd>{s.vendors.join(', ')}</dd></div>}
          {s.statusNote && <div><dt>Scoping</dt><dd>{s.statusNote}</dd></div>}
        </dl>
      </div>
    </section>

    <section class="block" aria-labelledby="b-get">
      <h2 id="b-get">What you get</h2>
      <div><ul class="rows list">{s.deliverables.map((d) => <li>{d}</li>)}</ul></div>
    </section>

    <section class="block" aria-labelledby="b-evidence">
      <h2 id="b-evidence">Evidence you can check</h2>
      <div>
        <ul class="rows list">{s.evidence.map((e) => <li>{e}</li>)}</ul>
        {s.links.length > 0 && (
          <p class="ctas">
            {s.links.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
          </p>
        )}
      </div>
    </section>

    {entry.body && (
      <section class="block" aria-labelledby="b-how">
        <h2 id="b-how">How it works</h2>
        <div class="prose"><Content /></div>
      </section>
    )}

    {related.length > 0 && (
      <section class="block" aria-labelledby="b-pairs">
        <h2 id="b-pairs">Pairs with</h2>
        <div>
          <ul class="rows pairs">
            {related.map((r) => (
              <li><a href={`/services/${r.id}/`}><span class="p-name">{r.data.name.replace(' — ', ': ')}</span><span>{r.data.oneLine}</span></a></li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .crumb { margin: 0 0 var(--space-4); font-size: var(--step--1); }
  .crumb a { display: inline-flex; align-items: center; min-height: 44px; }
  .tag { font-family: var(--font-display); font-weight: 550; font-size: var(--step-3); line-height: 1.1; letter-spacing: -0.02em; color: var(--accent); margin: 0; }
  .facts { margin: var(--space-5) 0 0; display: grid; gap: var(--space-3); }
  .facts div { display: grid; gap: 0 var(--space-4); }
  .facts dt { font-weight: 650; color: var(--fg-strong); }
  .facts dd { margin: 0; }
  @media (min-width: 600px) { .facts div { grid-template-columns: 8rem minmax(0, 1fr); } }
  .list li { padding: var(--space-3) 0; max-width: 46rem; }
  .pairs a { display: grid; gap: var(--space-1); padding: var(--space-4) 0; text-decoration: none; color: var(--fg); }
  .p-name { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); letter-spacing: -0.015em; color: var(--fg-strong); }
  .pairs a:hover .p-name { color: var(--accent); }
</style>
