---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page does not exist." noindex>
  <div class="wrap page">
    <div class="page-head">
      <p class="code" aria-hidden="true">404</p>
      <h1>No evidence for this page.</h1>
      <p class="lede">Nothing lives at this address, so nothing is reported here. The link may be old or mistyped.</p>
      <p class="ctas"><a class="btn btn-primary" href="/">Go to the home page</a> <a class="btn" href="/#services">See the services</a></p>
    </div>
  </div>
</Base>

<style>
  .code { font-family: var(--font-display); font-weight: 750; font-size: clamp(6rem, 24vw, 14rem); line-height: 0.85; letter-spacing: -0.05em; color: var(--cobalt); margin: 0 0 var(--space-5); }
</style>
