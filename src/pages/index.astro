---
// The home page, person first: who Marlon is, the work you can check, how to
// hire him, and one email at the end. Content comes from the collections and
// src/lib/site.ts; every number carries its source.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Fabric from '../components/Fabric.astro';
import Portrait from '../components/Portrait.astro';
import CertBadges from '../components/CertBadges.astro';
import FAQ from '../components/FAQ.astro';
import CopyButton from '../components/CopyButton.astro';
import { SITE, VENDORS, METHOD, TRAJECTORY_HOME, PAPERS, STATEMENT, HERO_CREDENTIALS } from '../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const proof = (await getCollection('proof')).sort((a, b) => a.data.order - b.data.order);
const engagements = (await getCollection('engagements')).sort((a, b) => a.data.order - b.data.order);
const repos = (await getCollection('repos')).sort((a, b) => a.data.order - b.data.order);

const [feature, ...evidence] = proof;

const categories: { id: string; label: string }[] = [
  { id: 'network', label: 'Network and fabric' },
  { id: 'agents', label: 'Agents and platforms' },
  { id: 'inference', label: 'Local inference' },
  { id: 'method', label: 'Method and delivery' },
  { id: 'applied', label: 'Applied agents' },
];

// Oldest first: the route reads left to right, ending where Marlon is now.
const route = [...TRAJECTORY_HOME].reverse();

const questions = [
  "What stops the agents from reporting success before it's real?",
  'How do you benchmark local models against frontier APIs?',
  'What does quantum-safe ANYsec change in my fabric?',
];

const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Scoping question, from mairp.ai')}`;
---
<Base>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <div class="hero panel on-cobalt" id="top">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Marlon<br />Paz</h1>
        <p class="say">{STATEMENT}</p>
        <p class="who">Network and AI infrastructure architect in Abu Dhabi. I take plain-language intent to verified,
          on-device change across Cisco, Nokia, Juniper and SONiC fabrics.</p>
        <p class="ctas">
          <a class="btn btn-yellow" href={mailto}>Email Marlon</a>
          <button class="btn" type="button" data-twin-open>Ask my digital twin</button>
        </p>
      </div>
      <figure class="hero-fig">
        <Fabric />
        <figcaption>The reference fabric from <a href="https://github.com/mairp/agentic-netops">agentic-netops</a>. A service is
          reported ready only after each leaf confirms it.</figcaption>
      </figure>
      <ul class="creds" aria-label="Credentials">
        {HERO_CREDENTIALS.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>

  {/* ── About ────────────────────────────────────────────────────────── */}
  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <Portrait />
      <div>
        <h2 id="about-title">From carrier networks to agent fleets.</h2>
        <p class="lede">I started in 2014 keeping a mobile carrier's network running in San Salvador, then moved through
          banking and consulting estates. At Nokia in Portugal I spent five years designing IP/MPLS networks for power
          grids and railways, building data-centre fabrics, and automating how they are deployed and tested. Since 2024
          I work in Abu Dhabi on data-centre interconnect and cloud networking for sovereign AI programmes.</p>
        <p>Along the way the job changed. Today I build the automation itself: multivendor fabrics driven by declarative
          intent, agents that turn a sentence into verified change, and loops that repair drift instead of only reporting
          it. My rule is simple. Nothing is reported done until the device proves it.</p>
        <p><a href="/about/">Read the full story</a></p>
      </div>
    </div>
    <div class="wrap">
      <ol class="route" aria-label="Career, oldest first">
        {route.map((t, i) => (
          <li class:list={[{ now: i === route.length - 1 }]}>
            <span class="yr">{t.yr.replace(' — ', ' to ')}</span>
            <span class="ttl">{t.ttl}</span>
            <span class="org">{t.org.replace(' · ', ', ')}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── Proof ────────────────────────────────────────────────────────── */}
  <Section id="proof" title="Work you can check." layout="stack"
    intro="Everything here is public: a repository, a paper or a recording. Where a number appears, its source sits next to it.">
    <article class="feature">
      <video controls preload="none" playsinline poster="/assets/agentic-netops-demo-thumb.webp" aria-label="agentic-netops demo: intent to verified fabric in six and a half minutes">
        <source src="/assets/agentic-netops-demo.mp4" type="video/mp4" />
      </video>
      <div class="feature-text">
        <h3><a href={feature.data.url}>{feature.data.name}</a></h3>
        <p>{feature.data.note}</p>
        <p class="muted">The recording runs six and a half minutes: a VLAN, an ip-vrf and a stretched mac-vrf provisioned
          from plain language, then proven with kubectl and on the SONiC leaves. The same design also runs on
          Nokia SR Linux, in <a href="https://github.com/mairp/agentic-netops-srl">agentic-netops-srl</a>.</p>
        <p class="figs">
          {feature.data.badge.split(' · ').map((b) => <span class="fig">{b}</span>)}
          <span class="fig-src">Source: {feature.data.source}</span>
        </p>
      </div>
    </article>
    <ul class="rows evidence">
      {evidence.map((p) => (
        <li>
          <h3><a href={p.data.url}>{p.data.name}</a></h3>
          <p>{p.data.note}</p>
          <p class="figs">{p.data.badge.split(' · ').map((b) => <span class="fig">{b}</span>)}<span class="fig-src">Source: {p.data.source}</span></p>
        </li>
      ))}
    </ul>
  </Section>

  {/* ── Services ─────────────────────────────────────────────────────── */}
  <Section id="services" title="How I can help."
    intro="Seven lines of work with one thesis: automation you can audit. Each has a defined outcome, a duration and public evidence behind it.">
    <ul class="rows services">
      {services.map((s) => (
        <li>
          <a href={`/services/${s.id}/`}>
            <span class="s-name">{s.data.name.replace(' — ', ': ')}</span>
            <span class="s-line">{s.data.oneLine}</span>
            <span class="s-dur">{s.data.duration}</span>
          </a>
        </li>
      ))}
    </ul>
    <h3 class="sub">Ways to engage</h3>
    <dl class="engs">
      {engagements.map((e) => (
        <div>
          <dt>{e.data.name}<span class="dur">{e.data.duration}</span></dt>
          <dd>{e.data.deliverable}</dd>
        </div>
      ))}
    </dl>
  </Section>

  {/* ── Method ───────────────────────────────────────────────────────── */}
  <Section id="method" title={`${METHOD}: intent in, evidence out.`} tone="ink" layout="stack"
    intro="It is the loop the reference system runs, and it is how I run engagements. Nothing advances without evidence.">
    <ol class="steps">
      <li>
        <h3>Intent</h3>
        <p>Plain language plus constraints. <q>Stretch this mac-vrf across both leaves</q> is captured, scoped and checked against policy.</p>
      </li>
      <li>
        <h3>Agents and controllers</h3>
        <p>Agents map the intent to declarative resources. Kubernetes controllers dry-run and apply them deterministically, with rollback.</p>
      </li>
      <li>
        <h3>Verified on device</h3>
        <p>gNMI proves it, or it did not happen. Each node passes a verification gate before the service is called ready.</p>
      </li>
    </ol>
    <p class="loop-back">Then it keeps checking. Telemetry flows from gNMI to Prometheus and Grafana, converged services are
      re-verified every five minutes, and drift is repaired and reported. The same loop runs my inference work: a prompt,
      a routed model, and a verified cost and latency per workload.</p>
  </Section>

  {/* ── Twin ─────────────────────────────────────────────────────────── */}
  <Section id="twin" title="Ask my digital twin."
    intro="An AI agent grounded in my public work. It explains how the verification, the telemetry loops or the local GPU serving work, and points back to the repository or paper.">
    <ul class="asks">
      {questions.map((q) => (
        <li><button type="button" data-twin-open data-twin-q={q}>{q}</button></li>
      ))}
    </ul>
    <p class="ctas"><button class="btn btn-primary" type="button" data-twin-open>Open the chat</button></p>
    <p class="muted twin-note">It is not a live person and it can be wrong, so check anything important. The twin is
      itself a served inference app with telemetry and a human-check in front of it.</p>
  </Section>

  {/* ── Papers, labs, method ─────────────────────────────────────────── */}
  <Section id="work" title="Papers, labs and a delivery method.">
    <ul class="rows depth">
      {PAPERS.map((p) => (
        <li>
          <span class="kind">Paper, {p.venue.split(' · ')[0]}</span>
          <div>
            <h3><a href={p.href} target="_blank" rel="noopener noreferrer">{p.name}</a></h3>
            <p>{p.note} Co-authored as mentor to the master's students who carried out the research.</p>
          </div>
        </li>
      ))}
      <li>
        <span class="kind">Labs</span>
        <div>
          <h3>Quantum-safe fabric labs on Nokia SR OS</h3>
          <p>Working containerlab labs for <a href="https://github.com/mairp/sros-anysec-lab">ANYsec</a>,
            <a href="https://github.com/mairp/sros-anysec-macsec-lab">ANYsec with MACsec</a> and
            <a href="https://github.com/mairp/srl-sros-telemetry-lab">streaming telemetry</a>. I presented the ANYsec
            demonstration at MPLS SD &amp; AI Net World 2024
            (<a href="https://www.youtube.com/watch?v=pAKnSQR694g" target="_blank" rel="noopener noreferrer">watch the demo</a>).</p>
        </div>
      </li>
      <li>
        <span class="kind">Method</span>
        <div>
          <h3>Specstride, spec-driven delivery for coding agents</h3>
          <p><a href="https://specstride.ai">specstride.ai</a> drives coding agents phase by phase behind an independent
            critic and learns from its own telemetry. <a href="https://github.com/mairp/mixture-of-loops">mixture-of-loops</a>
            compiles Spec Kit features into unattended pipelines.</p>
        </div>
      </li>
    </ul>
  </Section>

  {/* ── Open source ──────────────────────────────────────────────────── */}
  <Section id="open-source" title="The open-source ledger." layout="stack"
    intro="My public repositories, synced from GitHub every day and grouped by line of work.">
    <div class="ledger">
      {categories.map((c) => {
        const items = repos.filter((r) => r.data.category === c.id);
        return items.length > 0 && (
          <div class:list={['cat', `cat-${c.id}`]}>
            <h3>{c.label}</h3>
            <ul>
              {items.map((r) => (
                <li>
                  <a href={r.data.url} target="_blank" rel="noopener noreferrer">{r.data.name}</a>
                  <span class="desc">{r.data.description}</span>
                  <span class="meta">
                    {r.data.lang && <span>{r.data.lang}</span>}
                    {typeof r.data.stars === 'number' && r.data.stars > 0 && <span>{r.data.stars} {r.data.stars === 1 ? 'star' : 'stars'}</span>}
                    {r.data.forks === 'fork' && <span>fork</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
    <p class="muted"><a href="https://github.com/mairp?tab=repositories">See every repository on GitHub</a></p>
  </Section>

  {/* ── Certifications ───────────────────────────────────────────────── */}
  <Section id="background" title="Certified across the stack." layout="stack"
    intro={`Multivendor is the offer, not an add-on: ${VENDORS.map((v) => v.replace(/ \(.*\)$/, '')).join(', ')}.`}>
    <CertBadges />
  </Section>

  {/* ── FAQ ──────────────────────────────────────────────────────────── */}
  <Section id="faq" title="Asked, answered.">
    <FAQ />
  </Section>

  {/* ── Contact ──────────────────────────────────────────────────────── */}
  <Section id="contact" title="One email starts it." tone="yellow" layout="stack"
    intro="Scope a proof-of-value on your fabric, an assessment or a fractional engagement. Or just ask a hard question.">
    <p class="ctas contact-ctas">
      <a class="btn btn-ink" href={mailto}>Email Marlon</a>
      <CopyButton text={SITE.email} label="Copy the address" />
    </p>
    <p class="contact-meta">{SITE.email}. I reply within two working days, from {SITE.location}, in English, Español or Português.</p>
  </Section>
</Base>

<style>
  /* hero */
  .hero { padding: var(--space-7) 0 var(--space-5); margin-top: var(--space-1); }
  .hero-grid { display: grid; gap: var(--space-7) var(--space-6); }
  .hero h1 { font-size: var(--step-5); line-height: 0.86; letter-spacing: -0.05em; font-weight: 750; margin: 0 0 var(--space-6); }
  .say { font-family: var(--font-display); font-size: clamp(1.45rem, 1.1rem + 1.5vw, 2.1rem); font-weight: 550; line-height: 1.15; letter-spacing: -0.02em; color: var(--fg-strong); max-width: 22ch; margin: 0 0 var(--space-4); text-wrap: balance; }
  .who { max-width: 34rem; margin: 0; }
  .hero .ctas { margin-top: var(--space-6); }
  .hero-fig { margin: 0; align-self: center; justify-self: center; width: 100%; max-width: 30rem; }
  .hero-fig figcaption { margin-top: var(--space-4); font-size: var(--step--1); color: var(--muted); max-width: 26rem; }
  .creds { list-style: none; margin: 0; padding: var(--space-4) 0 0; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); font-size: var(--step--1); font-weight: 600; color: var(--fg-strong); }
  @media (min-width: 960px) {
    .hero { padding: var(--space-8) 0 var(--space-5); }
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .hero h1 { font-size: clamp(7rem, 11.5vw, 10.5rem); }
    .creds { grid-column: 1 / -1; justify-content: space-between; }
  }

  /* about */
  .about-grid { display: grid; gap: var(--space-6); align-items: start; }
  .about h2 { max-width: 14ch; }
  .about .lede { max-width: 42rem; }
  .about p { max-width: 42rem; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--space-7); } }
  .section { padding: var(--space-8) 0; }
  @media (min-width: 1000px) { .section { padding: var(--space-9) 0; } }

  /* the career route: a real sequence, drawn as a line with stops */
  .route { list-style: none; margin: var(--space-7) 0 0; padding: 0; display: grid; }
  .route li { position: relative; display: grid; gap: 2px; padding: 0 0 var(--space-5) var(--space-6); border-left: 2px solid var(--mist); }
  .route li:last-child { padding-bottom: 0; }
  .route li::before { content: ''; position: absolute; left: -8px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--paper); border: 2px solid var(--border-strong); }
  .route li.now::before { background: var(--yellow); border-color: var(--ink); }
  .route .yr { font-size: var(--step--1); color: var(--muted); }
  .route .ttl { font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; line-height: 1.2; letter-spacing: -0.015em; color: var(--fg-strong); }
  .route .org { font-size: var(--step--1); color: var(--fg); }
  @media (min-width: 1000px) {
    .route { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .route li { border-left: 0; border-top: 2px solid var(--mist); padding: var(--space-5) var(--space-4) 0 0; }
    .route li::before { left: 0; top: -8px; }
  }

  /* proof */
  .feature { display: grid; gap: var(--space-5); margin-bottom: var(--space-7); }
  .feature video { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius); background: var(--ink); display: block; }
  .feature h3, .evidence h3 { font-size: var(--step-2); margin-bottom: var(--space-3); }
  .feature h3 a, .evidence h3 a, .depth h3 a { color: inherit; text-decoration: none; }
  .feature h3 a:hover, .evidence h3 a:hover, .depth h3 a:hover { color: var(--accent); text-decoration: underline; }
  .figs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; }
  .figs .fig-src { flex-basis: 100%; }
  .evidence li { display: grid; gap: var(--space-2) var(--space-6); padding: var(--space-5) 0; }
  .evidence h3, .evidence p { margin: 0; }
  @media (min-width: 900px) {
    .feature { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-7); align-items: center; }
    .evidence li { grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr); align-items: start; }
  }

  /* services */
  .services a { display: grid; gap: var(--space-1) var(--space-5); padding: var(--space-5) 0; text-decoration: none; color: var(--fg); }
  .s-name { font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.02em; color: var(--fg-strong); }
  .s-dur { font-size: var(--step--1); color: var(--muted); }
  .services a:hover .s-name { color: var(--accent); }
  @media (min-width: 700px) {
    .services a { grid-template-columns: minmax(0, 1fr) auto; }
    .s-line { grid-column: 1; max-width: 40rem; }
    .s-dur { grid-column: 2; grid-row: 1; align-self: center; text-align: right; }
  }
  .sub { margin: var(--space-8) 0 var(--space-4); font-size: var(--step-2); }
  .engs { margin: 0; display: grid; gap: var(--space-5) var(--space-6); }
  .engs dt { font-weight: 650; color: var(--fg-strong); }
  .engs .dur { display: block; font-weight: 400; font-size: var(--step--1); color: var(--muted); }
  .engs dd { margin: var(--space-2) 0 0; font-size: var(--step--1); }
  @media (min-width: 700px) { .engs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* method: three numbered steps, because it is a sequence */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); counter-reset: step; }
  .steps li { counter-increment: step; border-top: 1px solid var(--border); padding-top: var(--space-4); }
  .steps li::before { content: counter(step); display: block; font-family: var(--font-display); font-weight: 700; font-size: 3.5rem; line-height: 1; letter-spacing: -0.04em; color: var(--yellow); margin-bottom: var(--space-4); }
  .steps h3 { font-size: var(--step-2); }
  .steps p { margin: 0; }
  .steps q { color: var(--fg-strong); }
  @media (min-width: 860px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .loop-back { margin: var(--space-7) 0 0; max-width: 46rem; color: var(--muted); }

  /* twin */
  .asks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); justify-items: start; }
  .asks button {
    font: inherit; font-family: var(--font-display); font-weight: 550; font-size: var(--step-1); line-height: 1.25; letter-spacing: -0.015em; text-align: left;
    color: var(--fg-strong); background: var(--surface); border: 0; border-radius: 20px 20px 20px 4px;
    padding: var(--space-4) var(--space-5); cursor: pointer; box-shadow: inset 0 0 0 1px var(--border); min-height: 48px;
  }
  .asks button:hover { box-shadow: inset 0 0 0 2px var(--cobalt); }
  .twin-note { margin: var(--space-5) 0 0; font-size: var(--step--1); max-width: 40rem; }

  /* papers, labs, method */
  .depth li { display: grid; gap: var(--space-2) var(--space-5); padding: var(--space-5) 0; }
  .depth .kind { font-size: var(--step--1); color: var(--muted); }
  .depth h3 { font-size: 1.3rem; margin-bottom: var(--space-2); }
  .depth p { margin: 0; }
  @media (min-width: 700px) { .depth li { grid-template-columns: 8rem minmax(0, 1fr); } .depth .kind { padding-top: 0.2rem; } }

  /* open-source ledger: the strand colour codes the category */
  .ledger { display: grid; gap: var(--space-7); margin-bottom: var(--space-6); }
  .cat { --strand: var(--strand-slate); }
  .cat-network { --strand: var(--strand-blue); }
  .cat-agents { --strand: var(--strand-orange); }
  .cat-inference { --strand: var(--strand-green); }
  .cat-method { --strand: var(--strand-brown); }
  .cat h3 { display: flex; align-items: center; gap: var(--space-3); font-size: var(--step-2); margin: 0; padding-bottom: var(--space-4); }
  .cat h3::before { content: ''; flex: none; width: 2.5rem; height: 6px; border-radius: 3px; background: var(--strand); }
  .cat ul { list-style: none; margin: 0; padding: 0; display: grid; column-gap: var(--space-7); }
  .cat li { display: grid; gap: 2px; align-content: start; padding: var(--space-4) 0; border-top: 1px solid var(--border); font-size: var(--step--1); }
  .cat li a { display: inline-flex; align-items: center; min-height: 32px; font-weight: 650; font-size: var(--step-0); color: var(--fg-strong); text-decoration: none; justify-self: start; }
  .cat li a:hover { color: var(--accent); text-decoration: underline; }
  .cat .meta { display: flex; gap: var(--space-4); color: var(--muted); font-size: 0.8125rem; }
  @media (min-width: 800px) { .cat ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .cat { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--space-6); }
    .cat h3 { align-self: start; padding: var(--space-4) 0 0; }
  }

  /* contact */
  .contact-ctas { margin-top: 0; }
  .contact-meta { margin: var(--space-5) 0 0; max-width: 40rem; }
</style>
