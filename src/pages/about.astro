---
// About: the person. The story, the career route, certifications, the working
// stack, publications and languages, plus the consultant profile (PDF).
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import CertBadges from '../components/CertBadges.astro';
import CopyButton from '../components/CopyButton.astro';
import { SITE, VENDORS, TRAJECTORY_ABOUT, PAPERS, SKILLS } from '../lib/site';
---
<Base title="About" description="Marlon Paz, network and AI infrastructure architect: the story, the career, certifications, publications and languages. Independent consulting from Abu Dhabi.">
  <div class="wrap page">
    <div class="about-head">
      <div class="page-head">
        <h1>The person behind the work.</h1>
        <p class="lede">I close the gap between what network and platform teams intend and what their fabric actually runs.
          For a decade across telecom, banking and critical-infrastructure networking, and now in Gulf AI data-centre
          programmes, I have built the automation that closes it: multivendor fabrics driven by declarative intent,
          multi-agent systems that turn plain language into verified change, and closed loops that repair drift instead of
          only reporting it.</p>
        <p>My operating rule is simple. Nothing is reported done until it is proven on the device.</p>
        <p class="ctas">
          <a class="btn btn-primary" href={SITE.cv}>Download the consultant profile (PDF)</a>
          <a class="btn" href={`mailto:${SITE.email}`}>Email Marlon</a>
          <CopyButton text={SITE.email} label="Copy the address" />
        </p>
      </div>
      <Portrait />
    </div>

    <section class="block" aria-labelledby="b-career">
      <h2 id="b-career">Career</h2>
      <div>
        <ol class="tl">
          {TRAJECTORY_ABOUT.map((t, i) => (
            <li class:list={[{ now: i === 0 }]}>
              <span class="yr">{t.yr.replace(' — ', ' to ')}</span>
              <span class="ttl">{t.ttl}</span>
              <span class="org">{t.org.replaceAll(' · ', ', ').replace(' — ', ': ')}</span>
            </li>
          ))}
        </ol>
        <p class="muted">I currently work at Core42. The independent practice is separate and claims no company endorsement.</p>
      </div>
    </section>

    <section class="block" aria-labelledby="b-certs">
      <h2 id="b-certs">Certifications</h2>
      <div><CertBadges /></div>
    </section>

    <section class="block" aria-labelledby="b-stack">
      <h2 id="b-stack">Working stack</h2>
      <div>
        <dl class="stack">
          {Object.entries(SKILLS).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          <div><dt>Vendors</dt><dd>{VENDORS.join(', ')}. Deliberately vendor-independent.</dd></div>
        </dl>
      </div>
    </section>

    <section class="block" aria-labelledby="b-quantum">
      <h2 id="b-quantum">Quantum-safe networking</h2>
      <div class="prose">
        <p>Hands-on, public and verifiable: <b>Nokia ANYsec</b>, post-quantum-resistant, line-rate encryption for
          data-centre fabrics, plus <b>MACsec</b> and <b>Nokia Network Group Encryption</b>. The work runs in public
          containerlab labs on Nokia SR OS FP5 vSIMs,
          <a href="https://github.com/mairp/sros-anysec-lab" target="_blank" rel="noopener noreferrer">sros-anysec-lab</a> and
          <a href="https://github.com/mairp/sros-anysec-macsec-lab" target="_blank" rel="noopener noreferrer">sros-anysec-macsec-lab</a>,
          building on the <a href="https://github.com/srl-labs/sros-anysec-macsec-lab" target="_blank" rel="noopener noreferrer">srl-labs originals</a>.
          I presented it as a quantum-safe ANYsec demonstration at MPLS SD &amp; AI Net World 2024
          (<a href="https://www.youtube.com/watch?v=pAKnSQR694g" target="_blank" rel="noopener noreferrer">watch the demo</a>).</p>
        <p class="muted">In depth: how post-quantum cryptography and keying change network design and operations, line-rate
          encryption inside EVPN/VXLAN fabrics, performance and latency trade-offs, and staged multivendor migration. The
          field is applied quantum-safe networking, not quantum-computing research.</p>
      </div>
    </section>

    <section class="block" aria-labelledby="b-papers">
      <h2 id="b-papers">Publications</h2>
      <div class="prose">
        {PAPERS.map((p) => (
          <p><a href={p.href} target="_blank" rel="noopener noreferrer"><b>{p.name}</b></a><br />
            <span class="muted">{p.venue.replace(' · ', ', ')}. {p.note}</span></p>
        ))}
        <p class="muted">Peer-reviewed, and co-authored as mentor to the master's students who carried out the research.</p>
      </div>
    </section>

    <section class="block" aria-labelledby="b-langs">
      <h2 id="b-langs">Languages and base</h2>
      <div class="prose">
        <p>Based in {SITE.location}. I work in English, Español and Português, which covers Gulf, Iberian and Latin
          American engagements natively.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-head { display: grid; gap: var(--space-6); align-items: start; padding-bottom: var(--space-7); }
  .about-head .page-head { padding-bottom: 0; }
  @media (min-width: 960px) { .about-head { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--space-7); } }
  .tl { list-style: none; margin: 0 0 var(--space-5); padding: 0; }
  .tl li { position: relative; display: grid; gap: 2px; padding: 0 0 var(--space-5) var(--space-6); border-left: 2px solid var(--mist); }
  .tl li:last-child { padding-bottom: 0; }
  .tl li::before { content: ''; position: absolute; left: -8px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--paper); border: 2px solid var(--border-strong); }
  .tl li.now::before { background: var(--yellow); border-color: var(--ink); }
  .tl .yr { font-size: var(--step--1); color: var(--muted); }
  .tl .ttl { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: 1.2; letter-spacing: -0.015em; color: var(--fg-strong); }
  .tl .org { font-size: var(--step--1); max-width: 40rem; }
  .stack { margin: 0; display: grid; gap: var(--space-4); max-width: 46rem; }
  .stack dt { font-weight: 650; color: var(--fg-strong); }
  .stack dd { margin: 0; }
</style>
